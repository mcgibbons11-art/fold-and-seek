{
  "name": "@foldseek/content-tools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "echo content-tools: run scripts directly",
    "build": "echo content-tools: nothing to build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "generate:audio": "node --env-file=../../.env --experimental-strip-types src/generate-audio.ts",
    "normalize:audio": "node --experimental-strip-types src/normalize-audio.ts",
    "ingest:supplied-audio": "node --experimental-strip-types src/ingest-supplied-audio.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
